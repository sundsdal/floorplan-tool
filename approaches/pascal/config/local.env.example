# Server. Supply values in the server environment or .env.local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GOOGLE_CLOUD_PROJECT=
GOOGLE_MANAGED_AGENT_ID=floorplan-pascal-review
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=floorplan-guide-pascal
LIVEKIT_GCS_BUCKET=
LIVEKIT_GCS_CREDENTIALS=
